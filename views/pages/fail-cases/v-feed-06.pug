block paragraph
  p [ FAIL CASE #01 ] 60 FPS WebGL CRT simulator &amp; AI body-tracking spaceship vs. 6 physical TVs and $4 RCA adapters.

block body
  .v-feed-06__wrapper
    .v-feed-06__toolbar.bg-color-surface
      .toolbar__left
        a.toolbar__back.body-micro.text-color-pure(href='/fail-cases', target='_self') &lt;-- INDEX /FAIL-CASES
        span.toolbar__badge.body-micro OVER-ENGINEERED / HARDWARE REALITY CHECK
      nav.toolbar__jumps(aria-label='Post-mortem section navigation')
        button.toolbar__jump.body-micro.text-color-default.js-section-jump(type='button', data-target='section-dossier') [00. DOSSIER]
        button.toolbar__jump.body-micro.text-color-default.js-section-jump(type='button', data-target='section-pitch') [01. PITCH_VS_REALITY]
        button.toolbar__jump.body-micro.text-color-default.js-section-jump(type='button', data-target='section-gallery') [02. EVIDENCE_09]
        button.toolbar__jump.body-micro.text-color-default.js-section-jump(type='button', data-target='section-pillars') [03. 4_PILLARS_OF_DOOM]
        button.toolbar__jump.body-micro.text-color-default.js-section-jump(type='button', data-target='section-receipts') [04. RECEIPTS]
        button.toolbar__jump.body-micro.text-color-default.js-section-jump(type='button', data-target='section-takeaways') [05. AUTOPSY]

    .v-feed-06__scroll
      //- 1. HEADER / CASE DOSSIER BANNER
      section#section-dossier.dossier-section.bg-color-surface.padding-x-y(data-reveal-section)
        +line-block('top-line')
        .dossier-header
          .dossier-header__top
            span.body-micro.text-color-muted(data-scramble) // SECTION 00 :: CASE DOSSIER &amp; METADATA SPEC SHEET
            span.body-micro.text-color-default(data-scramble) CASE_ID: FAIL-01 // REV_2026.10
          .dossier-grid
            .dossier-cell(data-reveal-item, data-parallax='-0.03')
              span.dossier-cell__label.body-micro.text-color-muted(data-scramble) PROJECT
              span.dossier-cell__value.code-command-default.text-color-pure(data-scramble) V-FEED [06]
            .dossier-cell(data-reveal-item, data-parallax='-0.015')
              span.dossier-cell__label.body-micro.text-color-muted(data-scramble) CLASSIFICATION
              span.dossier-cell__value.body-commentary.text-color-default FAIL CASE #01 — Interactive Transmedia CRT Installation
            .dossier-cell(data-reveal-item, data-parallax='0.015')
              span.dossier-cell__label.body-micro.text-color-muted(data-scramble) TL;DR METRIC
              span.dossier-cell__value.body-commentary.text-color-pure(data-scramble) 2,839 LOC Calibration GUI vs. 1 Loose Composite Cable
            .dossier-cell(data-reveal-item, data-parallax='0.03')
              span.dossier-cell__label.body-micro.text-color-muted(data-scramble) REPOSITORY
              .dossier-cell__link
                span.code-command-default.text-color-default $
                a.code-command-link.text-color-pure(href='https://github.com/felipeallmountain/v-feed-06', target='_blank', rel='noopener noreferrer') github.com/felipeallmountain/v-feed-06
            .dossier-cell.dossier-cell--wide(data-reveal-item)
              span.dossier-cell__label.body-micro.text-color-muted(data-scramble) STACK
              ul.dossier-tags
                each tech in ['TypeScript', 'Three.js / WebGL', 'Custom GLSL', '@mediapipe/tasks-vision', 'Web Audio API', 'Express', 'yt-dlp', '6x CRT Matrix']
                  li.dossier-tag.body-micro.text-color-default(data-scramble) [#{tech}]

          .dossier-verdict(data-reveal-item, data-parallax='0.04')
            +line-inline('left-line')
            .dossier-verdict__content
              span.body-micro.text-color-muted(data-scramble) OFFICIAL AUTOPSY VERDICT ::
              p.code-command-lg.text-color-pure "Wrote closed-form inverse bilinear quad-warping shaders and a 2,839-line calibration deck to fix problems that belonged to physics."
        +line-block('bottom-line')

      //- 2. THE PITCH VS. THE REALITY
      section#section-pitch.dossier-section.bg-color-surface.padding-x-y(data-reveal-section)
        +line-block('top-line')
        .section-heading(data-parallax='-0.03')
          span.body-micro.text-color-muted(data-scramble) // SECTION 01 :: EXPECTATION VS. EXHIBITION TELEMETRY
          h2.heading-title.text-color-pure(data-scramble) THE PITCH VS. THE REALITY_

        .pitch-reality-grid
          article.pitch-card(data-reveal-item, data-parallax='-0.04')
            .pitch-card__header
              span.pitch-card__tag.body-micro.text-color-pure(data-scramble) [ THE ART SCHOOL PITCH // WHAT I THOUGHT I WAS BUILDING ]
              span.body-micro.text-color-muted(data-scramble) SPEC_THEORY
            .pitch-card__body
              +line-inline('left-line')
              .pitch-card__copy.body-reading.text-color-default
                p An interactive transmedia art installation projecting vertical YouTube Shorts across a vertical totem of #[strong.text-color-pure 6 vintage Cathode Ray Tube (CRT) televisions] arranged in a #[strong.text-color-pure 2×3 matrix]—conceived as a cybernetic tribute to video artist Joshua Ellingson.
                p.pitch-card__quote.text-color-pure "Six cathode ray tubes, a YouTube feed, and a motion sensor: the user is the only missing wire in the system."
                p Spectators act as a #[strong.text-color-pure "Human Antenna"]—their physical distance (#[code 3m] to #[code 1m]), movement velocity, and body postures tuning or corrupting the analog broadcast in real time like human dipole antennas.

          article.pitch-card.pitch-card--reality(data-reveal-item, data-parallax='0.05')
            .pitch-card__header
              span.pitch-card__tag.pitch-card__tag--disaster.body-micro(data-scramble) [ EXHIBITION FLOOR REALITY // WHAT ACTUALLY HAPPENED ]
              span.body-micro.text-color-muted(data-scramble) FIELD_INCIDENT
            .pitch-card__body
              +line-inline('left-line')
              .pitch-card__copy.body-reading.text-color-default
                p Me crouched in the dark hitting #[code.text-color-pure Ctrl+Shift+C] to tweak #[code.text-color-pure poseGuideOffsetX: 0.29] and #[code.text-color-pure rgbSplit: 1.269] because the camera couldn't tell a gallery visitor from a shadow, while #[code.text-color-pure yt-dlp] downloaded 313 videos of boats sinking.
                p Instead of a seamless human-machine symbiosis, I built a 60 FPS WebGL spaceship to fight $4 plastic HDMI-to-RCA composite adapters, ambient gallery floodlights glaring off curved leaded glass, a webcam held to a steel shelf with a binder clip, and strangers who understandably refused to hold a "Rabbit Ears" pose in public for 1.8 seconds.
        +line-block('bottom-line')

      //- 3. PHOTO & MEDIA EVIDENCE GALLERY
      section#section-gallery.dossier-section.bg-color-surface.padding-x-y(data-reveal-section)
        +line-block('top-line')
        .section-heading.section-heading--split(data-parallax='-0.03')
          .section-heading__left
            span.body-micro.text-color-muted(data-scramble) // SECTION 02 :: PHOTOGRAPHIC FIELD EVIDENCE (/PUBLIC/ASSETS/V-FEED-06)
            h2.heading-title.text-color-pure(data-scramble) PHOTO &amp; MEDIA EVIDENCE_
          .gallery-filters(role='tablist', aria-label='Filter evidence photos')
            button.gallery-filter.body-micro.is-active.js-gallery-filter(type='button', data-filter='all') [ALL :: 09]
            button.gallery-filter.body-micro.js-gallery-filter(type='button', data-filter='primary') [CORE_EVIDENCE :: 04]
            button.gallery-filter.body-micro.js-gallery-filter(type='button', data-filter='vertical') [9:16_TOTEM :: 02]
            button.gallery-filter.body-micro.js-gallery-filter(type='button', data-filter='field') [FIELD_LOGS :: 03]

        p.body-commentary.text-color-default(data-reveal-item) Click any evidence frame to launch the full-resolution blueprint inspection view. Includes both 16:9 setup/HUD captures and vertical totem shots from the exhibition floor.

        .evidence-gallery
          each photo, idx in vFeedPhotos
            - var colOffset = (idx % 3 === 1) ? '0.045' : (idx % 3 === 2 ? '-0.03' : '0.02')
            figure.evidence-card.js-gallery-item(
              class=`evidence-card--${photo.orientation}`,
              data-reveal-item,
              data-parallax=colOffset,
              data-id=photo.id,
              data-src=photo.file,
              data-file=photo.file,
              data-title=photo.title,
              data-caption=photo.caption,
              data-aspect=photo.aspect,
              data-category=photo.category,
              tabindex='0',
              role='button',
              aria-label=`Inspect ${photo.id}: ${photo.title}`
            )
              .evidence-card__top.body-micro
                span.text-color-pure(data-scramble) [#{photo.id.toUpperCase()}]
                span.text-color-muted(data-scramble)= photo.aspect
              .evidence-card__media
                img.evidence-card__img(src=photo.file, alt=photo.alt, loading=idx < 4 ? 'eager' : 'lazy', data-parallax-img='0.14')
                .evidence-card__zoom.body-micro.text-color-pure [ + INSPECT FRAME ]
              figcaption.evidence-card__caption
                .evidence-card__title.code-command-default.text-color-pure= photo.title
                p.evidence-card__desc.body-commentary.text-color-default= photo.caption
                .evidence-card__file.body-micro.text-color-muted= photo.file
        +line-block('bottom-line')

      //- 4. ANATOMY OF THE OVER-ENGINEERING (THE 4 PILLARS OF DOOM)
      section#section-pillars.dossier-section.bg-color-surface.padding-x-y(data-reveal-section)
        +line-block('top-line')
        .section-heading(data-parallax='-0.03')
          span.body-micro.text-color-muted(data-scramble) // SECTION 03 :: HOW I BUILT A SPACESHIP FOR A TOASTER PROBLEM
          h2.heading-title.text-color-pure(data-scramble) ANATOMY OF THE OVER-ENGINEERING (THE 4 PILLARS OF DOOM)_

        .pillars-list
          //- PILLAR 01
          article.pillar-card(data-reveal-item, data-parallax='0.025')
            .pillar-card__header
              span.pillar-card__num.code-command-lg.text-color-pure(data-scramble, data-parallax='-0.08') [01]
              .pillar-card__titles
                h3.code-command-lg.text-color-pure(data-scramble) SIMULATING CRTS IN SOFTWARE... FOR REAL ANALOG CRTS
                span.body-micro.text-color-muted(data-scramble) CompositeShader.ts (346 LOC) + CRTShader.ts + NoiseShader.ts + AudioEngine.ts
            .pillar-card__body
              +line-inline('left-line')
              .pillar-card__content
                .body-reading.text-color-default
                  p The installation was designed for #[strong.text-color-pure six physical 14"–20" CRT televisions]—literal vacuum tubes with real curved leaded glass, real shadow-mask phosphor triads, real plastic bezels, and real 15.734 kHz flyback transformers.
                  p Instead of just sending video to the TVs, I wrote a #[strong.text-color-pure 346-line single-pass GLSL fragment shader (#[code CompositeShader.ts])] that mathematically simulates barrel glass curvature (#[code uCurvature], #[code uTubeCurve]), RGB shadow-mask phosphor triads and horizontal scanlines (#[code CRTShader.ts]), a 3D beveled dark plastic monitor chassis with specular highlights (#[code uBezelChassis]), chromatic aberration (#[code uRgbSplit]), V-Hold vertical frame roll (#[code uVHold]), horizontal sync jitter (#[code uHJitter]), and Gaussian RF snow (#[code NoiseShader.ts]).
                  p On top of that, I built a #[strong.text-color-pure Web Audio API synthesizer (#[code AudioEngine.ts])] with pink/white noise buffers and a sine oscillator locked to #[strong.text-color-pure 15,734 Hz] to emulate the NTSC CRT flyback transformer whine—for a room meant to have six real flyback transformers already screaming at 15,734 Hz. And when physical hardware and projection realities hit, the software ended up having to pretend to be the hardware it was supposed to feed.

                .code-evidence(data-reveal-item, data-parallax='0.04')
                  .code-evidence__header.body-micro
                    span.text-color-pure(data-scramble) // FILE: src/shaders/CompositeShader.ts (Closed-Form Inverse Bilinear Quad-Warping)
                    span.text-color-muted(data-scramble) GLSL FRAGMENT SHADER :: 38 UNIFORMS
                  pre.code-evidence__pre.body-commentary.text-color-default
                    code.
                      float cross2d(vec2 a, vec2 b) {
                        return a.x * b.y - a.y * b.x;
                      }

                      // Closed-form inverse bilinear interpolation for 24-point keystone pinning
                      vec2 invBilinear(vec2 p, vec2 p0, vec2 p1, vec2 p2, vec2 p3) {
                        vec2 e = p1 - p0;
                        vec2 f = p3 - p0;
                        vec2 g = p0 - p1 + p2 - p3;
                        vec2 h = p - p0;

                        float k2 = cross2d(g, f);
                        float k1 = cross2d(e, f) + cross2d(h, g);
                        float k0 = cross2d(h, e);

                        if (abs(k2) &lt; 0.0001) {
                          float u = (h.x * k1 + f.x * k0) / (e.x * k1 - g.x * k0 + 0.00001);
                          float v = -k0 / (k1 + 0.00001);
                          return vec2(u, v);
                        }

                        float w = k1 * k1 - 4.0 * k0 * k2;
                        if (w &lt; 0.0) return vec2(-1.0);
                        w = sqrt(w);

                        float v1 = (-k1 - w) / (2.0 * k2);
                        float u1 = (h.x - f.x * v1) / (e.x + g.x * v1 + 0.00001);
                        return vec2(u1, v1);
                      }

          //- PILLAR 02
          article.pillar-card(data-reveal-item, data-parallax='-0.025')
            .pillar-card__header
              span.pillar-card__num.code-command-lg.text-color-pure(data-scramble, data-parallax='-0.08') [02]
              .pillar-card__titles
                h3.code-command-lg.text-color-pure(data-scramble) SOLVING CARPENTRY WITH LIL-GUI: THE 2,839-LINE CALIBRATION CONSOLE
                span.body-micro.text-color-muted(data-scramble) CalibrationConsole.ts (2,839 LOC) + SyncChannel.ts + config/calibration.json (351 LOC)
            .pillar-card__body
              +line-inline('left-line')
              .pillar-card__content
                .body-reading.text-color-default
                  p Mounting and aligning 6 displays in a real physical space is messy. Instead of solving alignment with a wrench, a shim, or a spirit level, I tried to solve carpentry in WebGL.
                  p I built #[code.text-color-pure CalibrationConsole.ts]—a #[strong.text-color-pure 2,839-line #[code lil-gui] mission control deck] synced across browser windows via #[code BroadcastChannel] (#[code SyncChannel.ts]) and backed by a #[strong.text-color-pure 351-line JSON config (#[code config/calibration.json])]. It featured #[strong.text-color-pure 24-point 4-corner perspective keystone pinning] (#[code uCorners[24]]) solved per-pixel in GLSL, per-screen discrete 90° rotations, fine continuous angle rotation (#[code -180°] to #[code +180°]), X/Y sub-pixel offsets, individual horizontal/vertical flips for all 6 screens, per-screen signal lock and noise gain overrides, plus custom SMPTE color bars, crosshatch patterns, and focus reticles.

                .code-evidence(data-reveal-item, data-parallax='0.04')
                  .code-evidence__header.body-micro
                    span.text-color-pure(data-scramble) // FILE: config/calibration.json (Actual Committed Production Battle Scars)
                    span.text-color-muted(data-scramble) IEEE-754 DESPERATION &amp; TYPO IMMORTALITY
                  pre.code-evidence__pre.body-commentary.text-color-default
                    code.
                      {
                        "shader": {
                          "curvature": 2.6,
                          "rgbSplit": 1.269,
                          "vHold": 0,
                          "bezelChassis": true
                        },
                        "tracking": {
                          "zapHoldDurationMs": 400,
                          "poseGuideOffsetX": 0.29
                        },
                        "frames": [
                          {
                            "id": 0,
                            "label": "CRT [01}",
                            "offsetX": -0.00600000000000001,
                            "offsetY": 0.014,
                            "fineAngle": -1.4,
                            "rotation": 0,
                            "flipX": false,
                            "flipY": false
                          }
                        ]
                      }

          //- PILLAR 03
          article.pillar-card(data-reveal-item, data-parallax='0.025')
            .pillar-card__header
              span.pillar-card__num.code-command-lg.text-color-pure(data-scramble, data-parallax='-0.08') [03]
              .pillar-card__titles
                h3.code-command-lg.text-color-pure(data-scramble) THE OVER-THINKER'S COMPUTER VISION PIPELINE: HUMAN WALKIE-TALKIES
                span.body-micro.text-color-muted(data-scramble) FeatureExtractor.ts + BroadcastQuerySynthesizer.ts (@mediapipe/tasks-vision @ 60 FPS)
            .pillar-card__body
              +line-inline('left-line')
              .pillar-card__content
                .body-reading.text-color-default
                  p Using #[code.text-color-pure @mediapipe/tasks-vision] (running #[code PoseLandmarker] with 33 3D body joints + #[code HandLandmarker] with 21 hand joints in Wasm/GPU at 60 FPS), I refused to simply map proximity to static noise. Instead, I engineered a full semantic classifier that:
                  p #[strong.text-color-pure 1. Optical Inverse-Square Rangefinder:] Estimates physical distance in meters using the Euclidean span between shoulder landmarks #[code 11] and #[code 12] (which immediately hallucinated whenever a child walked into the frame).
                  p #[strong.text-color-pure 2. Harmonic Wrist Zero-Crossing Dance Detector:] Analyzes a #[code 1,800 ms] rolling window of vertical wrist velocity zero-crossings (#[code 1.2 Hz–2.5 Hz]) to classify whether the spectator is #[strong.text-color-pure dancing rhythmically] (#[code RHYTHMIC]) versus #[strong.text-color-pure flailing erratically] (#[code HIGH_MOTION]).
                  p #[strong.text-color-pure 3. Torso HSV Clothing Color Sampler:] Samples a #[code 48×48] offscreen canvas across the user's torso, converts RGB to HSV, and classifies their outfit (#[code WARM_RED], #[code COOL_BLUE], #[code DARK_NEUTRAL], #[code NEUTRAL]) to tint the YouTube search query mood.
                  p #[strong.text-color-pure 4. Six Antenna Postures &amp; The 1.8s Panic Patch:] Mapped 6 specific body postures 1:1 to the 6 CRT screens—originally requiring visitors to hold a pose for #[strong.text-color-pure 1.8 seconds] (#[code 1,800 ms]), which had to be panic-tuned down to #[code.text-color-pure zapHoldDurationMs: 400] because no human being in an art gallery will hold a T-pose for 1.8 seconds in front of strangers without feeling ridiculous.

                .pose-matrix-grid
                  .pose-chip(data-reveal-item, data-parallax='-0.02')
                    span.body-micro.text-color-muted(data-scramble) CRT [01} :: POSE_ANTENNA
                    span.code-command-default.text-color-pure(data-scramble) "Rabbit Ears"
                  .pose-chip(data-reveal-item, data-parallax='0.02')
                    span.body-micro.text-color-muted(data-scramble) CRT [02] :: POSE_DIAL_TUNER
                    span.code-command-default.text-color-pure(data-scramble) "Yagi Point"
                  .pose-chip(data-reveal-item, data-parallax='-0.02')
                    span.body-micro.text-color-muted(data-scramble) CRT [03] :: POSE_SURPRISE
                    span.code-command-default.text-color-pure(data-scramble) "TV Shock"
                  .pose-chip(data-reveal-item, data-parallax='0.02')
                    span.body-micro.text-color-muted(data-scramble) CRT [04] :: POSE_WINGSUIT
                    span.code-command-default.text-color-pure(data-scramble) "Horizontal Dipole"
                  .pose-chip(data-reveal-item, data-parallax='-0.02')
                    span.body-micro.text-color-muted(data-scramble) CRT [05] :: POSE_LOOP_HALO
                    span.code-command-default.text-color-pure(data-scramble) "UHF Loop"
                  .pose-chip(data-reveal-item, data-parallax='0.02')
                    span.body-micro.text-color-muted(data-scramble) CRT [06] :: POSE_SIGNAL_LOCK
                    span.code-command-default.text-color-pure(data-scramble) "Human Capacitor"

          //- PILLAR 04
          article.pillar-card(data-reveal-item, data-parallax='-0.02')
            .pillar-card__header
              span.pillar-card__num.code-command-lg.text-color-pure(data-scramble, data-parallax='-0.08') [04]
              .pillar-card__titles
                h3.code-command-lg.text-color-pure(data-scramble) THE 4.5-HOUR SOAK TEST, YOUTUBE QUOTA BURN &amp; EXHIBITION PHYSICS
                span.body-micro.text-color-muted(data-scramble) QuotaGuard.ts + LRU Disk Cache + reports/perf-report-latest.md
            .pillar-card__body
              +line-inline('left-line')
              .pillar-card__content
                .body-reading.text-color-default
                  p Every synthesized body query hit the #[strong.text-color-pure YouTube Data API v3 (#[code search.list])] at #[strong.text-color-pure 100 quota units per call], spawning #[code yt-dlp] and #[code ffmpeg] on an Express backend to transcode vertical MP4s on the fly.
                  p During a #[strong.text-color-pure 4.5-hour soak test] (#[code reports/perf-report-latest.md]), the installation downloaded #[strong.text-color-pure 313 bizarre vintage Shorts]—ranging from #[em 1950s TV test patterns] and #[em Max Headroom] to #[em SpongeBob lost episodes] and #[em pontoon boats hitting rocks]—burning #[strong.text-color-pure 4,140 quota units] at #[strong.text-color-pure 919.9 units/hr]. That meant the 10,000-unit daily Google Cloud quota would die #[strong.text-color-pure 5.3 hours into an 8-hour gallery day], forcing me to emergency-engineer a #[code QuotaGuard.ts] circuit breaker and an LRU disk cache pruner.
                  p Meanwhile, in the physical venue: camera angles, portrait webcam rotation matrices (#[code 0°/90°/180°/270°]), ambient glare on glass, cable spaghetti, and real human behavior proved that no amount of TypeScript architecture diagrams (I wrote #[strong.text-color-pure 8 full architecture manuals]—12 markdown files total—for a 1-person project) survives first contact with an exhibition space.
        +line-block('bottom-line')

      //- 5. "BY THE NUMBERS" RECEIPT TABLE
      section#section-receipts.dossier-section.bg-color-surface.padding-x-y(data-reveal-section)
        +line-block('top-line')
        .section-heading(data-parallax='-0.03')
          span.body-micro.text-color-muted(data-scramble) // SECTION 04 :: THE OVER-ENGINEERING RECEIPT
          h2.heading-title.text-color-pure(data-scramble) "BY THE NUMBERS" RECEIPT TABLE_

        .receipt-table-wrap(data-parallax='0.03')
          table.receipt-table
            thead
              tr.body-micro.text-color-muted
                th(data-scramble) METRIC / SUBSYSTEM
                th(data-scramble) RECORDED VALUE
                th(data-scramble) FIELD AUDIT NOTES
            tbody
              each row in receiptRows
                tr(data-reveal-item)
                  td.code-command-default.text-color-pure= row.metric
                  td.receipt-table__val.code-command-default(data-scramble)= row.value
                  td.body-commentary.text-color-default= row.notes
        +line-block('bottom-line')

      //- 6. POST-MORTEM TAKEAWAYS ("WHY IT'S IN /FAIL-CASES")
      section#section-takeaways.dossier-section.bg-color-surface.padding-x-y(data-reveal-section)
        +line-block('top-line')
        .section-heading(data-parallax='-0.03')
          span.body-micro.text-color-muted(data-scramble) // SECTION 05 :: AUTOPSY SUMMARY &amp; LESSONS LEARNED
          h2.heading-title.text-color-pure(data-scramble) WHY IT'S IN /FAIL-CASES_

        .takeaways-grid
          article.takeaway-item(data-reveal-item, data-parallax='-0.03')
            .takeaway-item__line
              +line-inline('left-line')
            .takeaway-item__body
              span.code-command-default.text-color-pure(data-scramble) [01] ATOMS ARE UNDEFEATED
              p.body-reading.text-color-default Software is frictionless; atoms are undefeated. No shader uniform can fix a loose RCA composite plug or a $4 plastic signal converter overheating behind a steel shelf.
          article.takeaway-item(data-reveal-item, data-parallax='0.0')
            .takeaway-item__line
              +line-inline('left-line')
            .takeaway-item__body
              span.code-command-default.text-color-pure(data-scramble) [02] PUT DOWN THE KEYBOARD, PICK UP A SCREWDRIVER
              p.body-reading.text-color-default If you find yourself writing a 2D cross-product quadratic solver in a fragment shader because a display is crooked, put down the keyboard and pick up a screwdriver.
          article.takeaway-item(data-reveal-item, data-parallax='0.03')
            .takeaway-item__line
              +line-inline('left-line')
            .takeaway-item__body
              span.code-command-default.text-color-pure(data-scramble) [03] HUMANS ARE NOT DETERMINISTIC STATE MACHINES
              p.body-reading.text-color-default Twelve architecture markdown files and a 4.5-hour soak test won't save you when your entire interactive loop depends on strangers doing "Rabbit Ears" poses for 1.8 seconds in front of a binder-clipped webcam.

        .dossier-footer(data-reveal-item)
          .dossier-footer__nav
            span.code-command-default.text-color-default $
            a.code-command-link.text-color-pure(href='/fail-cases', target='_self') cd /fail-cases
          .dossier-footer__nav
            span.code-command-default.text-color-default $
            a.code-command-link.text-color-pure(href='https://github.com/felipeallmountain/v-feed-06', target='_blank', rel='noopener noreferrer') git clone https://github.com/felipeallmountain/v-feed-06
        +line-block('bottom-line')

