extends ../base.pug
include ../mixins/line.pug

mixin link(number, label, url, description)
  .link.bg-color-surface.padding-x-y
    .link__number.code-command-default.padding-y.text-color-muted [#{number}]
    .link__content
      .content__top
        +line-block('top-line')
        .top__url
          .url__symbol.code-command-default.text-color-default $
          a.code-command-link.text-color-pure(href=url, target='_self')= label
      .content__description.body-commentary
        p.padding-y.text-color-default= description
        +line-block('bottom-line')

block variables
  - var template = 'fail-cases'
  - var links = [{ label: '/fail-cases', url: '/fail-cases' }]
  - var pageTitle = 'THE GALLERY OF MEDIOCRITY_'
  - var pageDescription = 'A gallery of spiteful experiments, visually abusive portfolios, and tools that generate more errors than code.'

block body
  .fail-cases__links
    +link('01', '/the-spite-ful-portfolio', '/the-spite-ful-portfolio', 'A portfolio that is, frankly, visually abusive')
    +link('02', '/the-user-friendly-nav', '/the-user-friendly-nav', 'The navigation menu I designed while deliberately ignoring every standard UX principle.')
    +link('03', '/rejection-letter-generator', '/rejection-letter-generator', "Simulate being rejected from that desired work you're applying, or reject that person you don't wish to work with")
    +link('04', '/boring-clock', '/boring-clock', 'Procrastinate your time by watching time, waste your precious time and postpone your deadlines, feel free to blame me when you get fired.')
    +link('05', '/compiler-annoying-tool', '/compiler-annoying-tool', 'A script that generates more errors than code')
