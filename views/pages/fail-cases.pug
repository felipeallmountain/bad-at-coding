extends ../base.pug
include ../mixins/line.pug
include ../mixins/responsive-image.pug

block variables
  - var template = 'fail-cases'
  - var canonicalPath = '/fail-cases'
  - var links = [{ label: '/fail-cases', url: '/fail-cases' }]
  - var pageTitle = 'THE GALLERY OF MEDIOCRITY_'
  - var pageDescription = 'A catalog of over-engineered, cursed, and gloriously doomed engineering projects where software hubris collided with physical reality.'
  - var ogType = 'website'
  - var ogTitle = 'THE GALLERY OF MEDIOCRITY · /fail-cases'
  - var ogDescription = 'A catalog of over-engineered, cursed, and gloriously doomed engineering projects where software hubris collided with physical reality. Featuring [FAIL-01] V-FEED [06].'
  - var ogImage = '/og-fail-cases.jpg'
  - var ogImageWidth = 1200
  - var ogImageHeight = 630
  - var ogImageAlt = 'bad at coding /fail-cases — THE GALLERY OF MEDIOCRITY featuring V-FEED [06] 6x CRT matrix'
  - var pageKeywords = 'fail cases, engineering post-mortem, over-engineering, creative coding, WebGL, Three.js, GLSL, CRT installation, bad at coding'
  - var twitterLabel1 = 'ARCHIVE STATUS'
  - var twitterData1 = '01 Declassified Dossier // 04 Pending'
  - var twitterLabel2 = 'FEATURED INCIDENT'
  - var twitterData2 = 'FAIL-01 :: V-FEED [06]'
  - var showParagraph = true
  -
    var failCases = [
      {
        id: 'FAIL-01',
        slug: 'v-feed-06',
        url: '/fail-cases/v-feed-06',
        title: 'V-FEED [06]',
        subtitle: 'Building a 60 FPS WebGL CRT Simulator & AI Body-Tracking Spaceship to Fight 6 Physical TVs and HDMI-to-RCA Adapters',
        status: 'OVER-ENGINEERED / HARDWARE REALITY CHECK',
        tags: ['Three.js', 'GLSL', 'MediaPipe Wasm', 'Web Audio API', 'Node.js', '6x CRT Matrix'],
        tldrMetric: '2,839 LOC Calibration GUI vs. 1 Loose Composite Cable',
        thumbnail: '/assets/v-feed-06/DSC_3270.webp',
        thumbnailFallback: '/assets/v-feed-06/DSC_3270.jpg',
        thumbnailWidth: 2400,
        thumbnailHeight: 1600,
        thumbnailAlt: 'V-FEED [06] — 6 physical CRT televisions mounted in a 2x3 steel rack matrix on the exhibition floor',
        summary: 'Wrote a 346-line single-pass CRT shader, a 15,734 Hz NTSC flyback oscillator, a 60 FPS MediaPipe pose & clothing-color classifier, and a 2,839-line calibration deck to fix problems that belonged to a screwdriver and a $4 composite adapter.'
      }
    ]

block paragraph
  p // A catalog of over-engineered, cursed, or gloriously doomed engineering projects.

block body
  .fail-cases__catalog
    each item in failCases
      article.fail-card.bg-color-surface.padding-x-y
        +line-block('top-line')
        .fail-card__header
          .fail-card__identity
            span.fail-card__id.code-command-default.text-color-pure [#{item.id}]
            .fail-card__title-wrap
              span.url__symbol.code-command-default.text-color-default $
              a.fail-card__title.heading-title.text-color-pure(href=item.url, target='_self')= item.title
          span.fail-card__badge.body-micro= item.status

        .fail-card__body
          .fail-card__details
            .fail-card__lead
              +line-inline('left-line')
              .fail-card__copy
                p.fail-card__subtitle.code-command-lg.text-color-pure= item.subtitle
                p.fail-card__summary.body-commentary.text-color-default= item.summary

            .fail-card__metric-box
              span.metric-box__label.body-micro.text-color-muted TL;DR_METRIC ::
              span.metric-box__value.code-command-default.text-color-pure= item.tldrMetric

            .fail-card__footer
              ul.fail-card__tags
                each tag in item.tags
                  li.fail-card__tag.body-micro.text-color-default [#{tag}]
              .fail-card__cta
                span.code-command-default.text-color-default $
                a.code-command-link.text-color-pure(href=item.url, target='_self') cat /fail-cases/#{item.slug} --post-mortem

          a.fail-card__media(href=item.url, target='_self', aria-label=`Open ${item.title} post-mortem`)
            .fail-card__media-frame
              +responsive-image({
                src: item.thumbnail,
                fallback: item.thumbnailFallback,
                alt: item.thumbnailAlt,
                pictureClass: 'fail-card__picture',
                imgClass: 'fail-card__img',
                sizes: '(max-width: 640px) 92vw, (max-width: 1024px) 88vw, 35vw',
                loading: 'eager',
                fetchpriority: 'high',
                width: item.thumbnailWidth,
                height: item.thumbnailHeight
              })
              .fail-card__media-overlay
                span.body-micro.text-color-pure [ EXHIBIT_EVIDENCE :: 13 PHOTOS ATTACHED ]
                span.body-micro.text-color-default.js-scramble-text OPEN DOSSIER -&gt;

        +line-block('bottom-line')

    .fail-cases__telemetry.bg-color-surface.padding-x-y
      .telemetry__row.body-micro.text-color-muted
        span [ ARCHIVE_STATUS: 01 DECLASSIFIED DOSSIER // 04 INCIDENTS PENDING AUTOPSY ]
        span [ FILTER: HARDWARE_HUBRIS = TRUE | COST_TO_BENEFIT_RATIO = NaN ]
