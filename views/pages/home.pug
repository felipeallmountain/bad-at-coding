extends ../base.pug
include ../mixins/line.pug

mixin link(symbol, label, url, description)
  .link.code-command-default
    .link__symbol
      .symbol__start
        +line-inline('left-line')
      .symbol__symbol.text-color-default [#{ symbol }]
    .link__link.text-color-pure
      .code-command-default $
      a.code-command-link(href=url, target='_self')= label
    .link__description.text-color-muted= description

block variables
  - var template = 'home'
  - var pageTitle = 'WELCOME TO MY MISERY_'
  - var pageDescription = 'This site exists to remind me why I prefer the company of my bicycle, my computer and black coffee to yours. Code that works out of pure spite and designs that ignore your feelings.'
  - var showParagraph = true


block paragraph
  p This site exists to remind me why I prefer the company of my bicycle, my computer and black coffee to yours.
  p If you are looking for a fullstack ninja, you are in the wrong place.
  p Here there is only code that works out of pure spite and designs that ignore your feelings

block body
  .home__links.bg-color-surface
    .link.top
      .top__start
      .top__middle
        +line-block('top-line')
      .top__end
        +line-block('top-line')
    +link('!', '/fail-cases', '/fail-cases', '// The gallery of mediocrity.')
    +link('?', '/who-i-am-not', '/who-i-am-not', '// Not your friend.')
    +link('#', '/annoy-me', '/annoy-me', '// Only if strictly necessary.')
    .link.bottom
      .bottom__start
      .bottom__middle
        +line-block('bottom-line')
      .bottom__end
