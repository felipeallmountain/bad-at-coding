extends ../base.pug

block variables
  - var template = 'home'

block body
  .home
    .home__welcome
      h1.welcome__title.heading-display WELCOME TO MY MISERY_
      .welcome__description.body-reading
        p This site exists to remind me why I prefer the company of my bicycle, my computer and black coffee to yours.
        p If you are looking for a Full-stack ninja, you are in the wrong place.
        p Here there is only code that works out of pure spite and designs that ignore your feelings
    .home__links
      a(href='#', target='self') /fail-cases
      a(href='#', target='self') /who-i-am-not
      a(href='#', target='self') /annoy-me
