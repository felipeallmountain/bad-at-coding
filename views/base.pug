include mixins/line.pug
block variables

- var siteUrl = typeof siteUrl !== 'undefined' ? siteUrl : 'https://bad-at-coding.com'
- var siteName = typeof siteName !== 'undefined' ? siteName : 'bad at coding'
- var canonicalPath = typeof canonicalPath !== 'undefined' ? canonicalPath : '/'
- var pageTitle = typeof pageTitle !== 'undefined' ? pageTitle : 'BAD AT CODING_'
- var pageDescription = typeof pageDescription !== 'undefined' ? pageDescription : 'Code that works out of pure spite and designs that ignore your feelings.'
- var cleanPageTitle = pageTitle.replace(/_+$/, '')
- var documentTitle = (typeof socialTitle !== 'undefined' ? socialTitle : cleanPageTitle) + ' · ' + siteName
- var canonicalUrl = siteUrl + (canonicalPath === '/' ? '/' : canonicalPath)
- var ogType = typeof ogType !== 'undefined' ? ogType : 'website'
- var ogTitle = typeof ogTitle !== 'undefined' ? ogTitle : cleanPageTitle
- var ogDescription = typeof ogDescription !== 'undefined' ? ogDescription : pageDescription
- var ogImagePath = typeof ogImage !== 'undefined' ? ogImage : '/og-image.jpg'
- var ogImageUrl = ogImagePath.startsWith('http') ? ogImagePath : siteUrl + ogImagePath
- var ogImageType = typeof ogImageType !== 'undefined' ? ogImageType : 'image/jpeg'
- var ogImageWidth = typeof ogImageWidth !== 'undefined' ? String(ogImageWidth) : '1200'
- var ogImageHeight = typeof ogImageHeight !== 'undefined' ? String(ogImageHeight) : '630'
- var ogImageAlt = typeof ogImageAlt !== 'undefined' ? ogImageAlt : 'bad at coding — WELCOME TO MY MISERY'
- var twitterCard = typeof twitterCard !== 'undefined' ? twitterCard : 'summary_large_image'
- var twitterTitle = typeof twitterTitle !== 'undefined' ? twitterTitle : ogTitle
- var twitterDescription = typeof twitterDescription !== 'undefined' ? twitterDescription : ogDescription
- var twitterImageUrl = typeof twitterImage !== 'undefined' ? (twitterImage.startsWith('http') ? twitterImage : siteUrl + twitterImage) : ogImageUrl
- var twitterImageAlt = typeof twitterImageAlt !== 'undefined' ? twitterImageAlt : ogImageAlt
- var pageAuthor = typeof pageAuthor !== 'undefined' ? pageAuthor : 'Felipe Vega'
- var pageKeywords = typeof pageKeywords !== 'undefined' ? pageKeywords : ''

doctype html

mixin nav-link(url, label)
  li.link-container
    a.link(href=url, target='_self') #{ label }

html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')

    base(href='/')

    title= documentTitle
    meta(name='description', content=pageDescription)
    if pageAuthor
      meta(name='author', content=pageAuthor)
    if pageKeywords
      meta(name='keywords', content=pageKeywords)
    link(rel='canonical', href=canonicalUrl)

    meta(property='og:type', content=ogType)
    meta(property='og:site_name', content=siteName)
    meta(property='og:title', content=ogTitle)
    meta(property='og:description', content=ogDescription)
    meta(property='og:url', content=canonicalUrl)
    meta(property='og:image', content=ogImageUrl)
    meta(property='og:image:secure_url', content=ogImageUrl)
    meta(property='og:image:type', content=ogImageType)
    meta(property='og:image:width', content=ogImageWidth)
    meta(property='og:image:height', content=ogImageHeight)
    meta(property='og:image:alt', content=ogImageAlt)
    meta(property='og:locale', content='en_US')
    if ogType === 'article'
      if typeof articleAuthor !== 'undefined' && articleAuthor
        meta(property='article:author', content=articleAuthor)
      if typeof articleSection !== 'undefined' && articleSection
        meta(property='article:section', content=articleSection)
      if typeof articlePublishedTime !== 'undefined' && articlePublishedTime
        meta(property='article:published_time', content=articlePublishedTime)
      if typeof articleTags !== 'undefined' && articleTags && articleTags.length > 0
        each tag in articleTags
          meta(property='article:tag', content=tag)

    meta(name='twitter:card', content=twitterCard)
    meta(name='twitter:url', content=canonicalUrl)
    meta(name='twitter:title', content=twitterTitle)
    meta(name='twitter:description', content=twitterDescription)
    meta(name='twitter:image', content=twitterImageUrl)
    meta(name='twitter:image:alt', content=twitterImageAlt)
    if typeof twitterLabel1 !== 'undefined' && typeof twitterData1 !== 'undefined'
      meta(name='twitter:label1', content=twitterLabel1)
      meta(name='twitter:data1', content=twitterData1)
    if typeof twitterLabel2 !== 'undefined' && typeof twitterData2 !== 'undefined'
      meta(name='twitter:label2', content=twitterLabel2)
      meta(name='twitter:data2', content=twitterData2)

    link(rel='icon', href='/favicon.ico', sizes='any')
    link(rel='icon', type='image/png', href='/favicon.png', sizes='32x32')
    link(rel='apple-touch-icon', href='/apple-touch-icon.png')

    link(rel='preload', href='../fonts/big-shoulders-stencil-v4-latin-500.woff2', as='font', type='font/woff2', crossorigin)
    link(rel='preload', href='../fonts/jetbrains-mono-v24-latin-regular.woff2', as='font', type='font/woff2', crossorigin)
    link(rel='preload', href='../fonts/jetbrains-mono-v24-latin-500.woff2', as='font', type='font/woff2', crossorigin)

    link(rel='stylesheet', href='../styles/main.scss')

  body
    .preloader
      .preloader__content
        .preloader__terminal.text-color-default.code-command-lg
          .preloader__line [OK] DELEGATING TO STACK OVERFLOW...
          .preloader__line [OK] REMOVING TODO COMMENTS (WITHOUT FIXING THEM)...
          .preloader__line [OK] BYPASSING CODE REVIEW RULES... 
          .preloader__line [OK] READY TO DISSAPOINT... 
    .wrapper
      canvas.grain-canvas
      canvas.cutting-mat-canvas
      header.header.code-command-default
        nav.nav
          ul.nav__content.text-color-pure.bg-color-surface.padding-nav-links
            +nav-link('/', 'BAD-AT-CODING') 
            if links && links.length > 0
              each navLink in links
                +nav-link(navLink.url, navLink.label)

      main.content.padding-content
        .cutting-mat
          .bg-grid
            .container.bg-color-surface.padding-x-y(
              class=`
                ${template}
                ${template}--col-start
                ${template}--col-end
                ${template}--row-start
                ${template}--row-end
              `,
              data-template=template
            )
              .container__desktop-content
                .container__title.padding-x-y(class=template+'__title')
                  h1.heading-display.text-color-pure=pageTitle
                  if showParagraph
                    .container__paragraph.code-command-lg.text-color-default
                      block paragraph
                .container__content(class=template+'__content')
                  block body

              // mobile container
              .container__mobile-placeholder.code-command-lg.text-color-default
                +line-inline('left-line')
                .mobile-content
                  .mobile-guard.mobile-guard__header
                    +line-block('top-line')
                    .header-content
                      span.mobile-guard__tag [ ERR_402: VIEWPORT TOO POOR ]
                      span.mobile-guard__status SYS_HALT
                  
                  .mobile-guard
                    +line-block('top-line')
                    h1.mobile-guard__title LAZY DEVELOPER GUARDRAIL ACTIVE
                    
                  .mobile-guard
                    +line-block('top-line')
                    .terminal-content
                      p.mobile-guard__line > ANALYZING DISPLAY SPECIFICATIONS...
                      p.mobile-guard__line > ASPECT RATIO: VERTICAL SLAB (UNSUPPORTED)
                      p.mobile-guard__line > DIAGNOSTIC: CSS Responsive engine bypassed on purpose.
                      p.mobile-guard__line.mobile-guard__line--highlight 
                        | > "I’ll refactor a mobile layout when I run out of excuses. Until then, respect the developer's laziness and switch to a real screen."
                  
                  .mobile-guard
                    +line-block('top-line')
                    .metric-content
                      .mobile-guard__metric
                        span.mobile-guard__label SUGGESTED_ACTION:
                        span.mobile-guard__value RESIZE_TO_MIN_1280PX
                      .mobile-guard__metric
                        span.mobile-guard__label ESTIMATED_MOBILE_ETA:
                        span.mobile-guard__value  WHEN I RUN OUT OF EXCUSES [ 0.0% ]

                  .mobile-guard
                    +line-block('top-line')
                    span.mobile-guard__footnote [ SYSTEM LOCKED — NO TOUCH EVENTS ALLOWED ]

      footer.footer.body-micro.text-color-muted
        .span bad-at-coding.com - ©️2026. All rights reserved. Or not. Whatever

    script(async, src='../app/main.ts', type='module')
