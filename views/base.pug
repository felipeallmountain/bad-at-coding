block variables

doctype html

mixin nav-link(url, label)
  li.link-container
    a.link(href=url, target='_self') #{ label }

html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')

    base(href='/')

    title= 'bad at coding'

    meta(name='description', content='content')

    link(rel='preload', href='../fonts/big-shoulders-stencil-v4-latin-500.woff2', as='font', type='font/woff2', crossorigin)
    link(rel='preload', href='../fonts/jetbrains-mono-v24-latin-regular.woff2', as='font', type='font/woff2', crossorigin)
    link(rel='preload', href='../fonts/jetbrains-mono-v24-latin-500.woff2', as='font', type='font/woff2', crossorigin)

    link(rel='stylesheet', href='../styles/main.scss')

  body
    .wrapper
      header.header.code-command-default
        nav.nav
          ul.nav__content.text-color-pure.bg-color-surface.padding-nav-links
            +nav-link('/', 'BAD-AT-CODING') 
            if links && links.length > 0
              each navLink in links
                +nav-link(navLink.url, navLink.label)

      main.content.padding-content
        .cutting-mat
          .bg-grid
            .container.bg-color-surface.shadow-right-up.padding-x-y(class=template, data-template=template)
              block body

      footer.footer.body-micro.text-color-muted
        .span bad-at-coding.com - ©️2026. All rights reserved. Or not. Whatever

    script(async, src='../app/main.ts', type='module')
